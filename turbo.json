{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["clean", "^build"],
      "outputs": ["dist/**"],
      // These exclusions claim a test/story/snapshot edit cannot change build
      // output. That is only true while each package's tsconfig.build.json
      // excludes the same files — keep the two lists in sync. When they drifted,
      // tsc compiled tests that turbo believed it ignored, so a type error in a
      // test survived every cached local build and only failed on cold CI.
      // The `typecheck` task below deliberately includes what this one drops.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/*.spec.ts",
        "!src/**/*.spec.tsx",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/**/__snapshots__/**"
      ]
    },
    "typecheck": {
      // ^build because packages resolve each other's types through generated
      // dist/*.d.ts. No outputs: tsc --noEmit produces none.
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "clean": {
      "cache": false,
      "inputs": ["package.json"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "stories/**/*.ts"],
      "outputs": ["storybook-static/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "interactive": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "dev:storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": ["BASE_URL", "PLAYWRIGHT_*"]
    },
    "generate:spells:check": {
      "inputs": [
        "src/lib/data/spells-2024.csv",
        "src/lib/data/spells-2024.generated.ts",
        "scripts/generate-spells.ts"
      ],
      "cache": false
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    }
  }
}
